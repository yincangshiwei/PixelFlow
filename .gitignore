# ── 打包产物 ──
dist/
build/

# ── 生成文件（由 build.py 从模板生成）──
installer.iss

# ── 运行时日志 ──
logs/
crash.log

# ── 运行时预设 ──
presets/

# ── AI 抠图模型权重（体积大，本地下载）──
models/

# ── AI 运行时数据（仅项目根目录：uv 工具 + 每模型独立 venv + settings）──
# 必须用 /runtime/ 锚定根目录，否则会误忽略源码包 core/runtime/
/runtime/

# ── IDE / 工具 ──
.codebuddy/*
!.codebuddy/rules/
.qwen/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Python 缓存 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 虚拟环境 ──
.venv/
venv/
env/
